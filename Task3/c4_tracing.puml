@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title Система «Александрит» - Контейнерная диаграмма с трейсингом

Person_Ext(customer, "Customer", "Покупает ювелирные изделия")
Person_Ext(api_user, "API user", "Внешний продавец, использует API")
Person(seller, "Seller", "Работает с заказами в CRM")
Person(operator, "Operator", "Производит изделия в MES")

System_Boundary(boundary, "Jewelry Store System") {
    Container(internet_shop, "Internet Shop", "Vue, TypeScript, Three.js", "Создание заказов, загрузка 3D-моделей, 3D-редактор")
    Container(shop_api, "Shop API", "SpringBoot", "Приём заказов, сохранение информации о заказах")
    ContainerDb(shop_db, "Shop DB", "PostgreSQL", "Данные о клиентах и заказах")
    
    Container(crm, "CRM", "Vue, Typescript", "Интерфейс для продавцов")
    Container(crm_api, "CRM API", "SpringBoot", "Управление статусами заказов")
    
    Container(mes, "MES", "React, TypeScript", "Интерфейс для операторов")
    Container(mes_api, "MES API", "C#", "Расчёт цены, назначение заказов операторам")
    ContainerDb(mes_db, "MES DB", "PostgreSQL", "Данные о заказах и статусах производства")
    
    Container(queue, "Messages Queue", "RabbitMQ", "Шина сообщений между сервисами")
    ContainerDb(s3, "3D files storage", "S3-based storage", "Хранение 3D-файлов")
    
    ' Трейсинг компоненты (КРАСНЫЙ)
    Container(otel_collector, "OTel Collector", "OpenTelemetry", "Сбор и экспорт трейсов", $tags="tracing")
    Container(jaeger, "Jaeger", "Jaeger UI", "Визуализация и поиск трейсов", $tags="tracing")
    
    ' Мониторинг компоненты (ЗЕЛЁНЫЙ)
    Container(prometheus, "Prometheus", "Prometheus", "Хранение метрик", $tags="monitoring")
    Container(alertmanager, "Alertmanager", "Alertmanager", "Управление алертами", $tags="monitoring")
    Container(grafana, "Grafana", "Grafana", "Дашборды и визуализация", $tags="monitoring")
}

' Основные потоки данных
Rel(customer, internet_shop, "Создаёт заказы")
Rel(internet_shop, shop_api, "HTTP/REST")
Rel(shop_api, shop_db, "CRUD")
Rel(shop_api, s3, "Загружает файлы")

Rel(seller, crm, "Управляет заказами")
Rel(crm, crm_api, "HTTP/REST")
Rel(crm_api, crm_api, "Обновляет статусы")
Rel(crm_api, queue, "Публикует сообщения")

Rel(operator, mes, "Выполняет заказы")
Rel(mes, mes_api, "HTTP/REST")
Rel(mes_api, mes_db, "CRUD")
Rel(mes_api, queue, "Публикует/потребляет")
Rel(mes_api, s3, "Читает 3D-файлы")

Rel(queue, crm_api, "Доставляет сообщения")
Rel(queue, mes_api, "Доставляет сообщения")

Rel(api_user, mes_api, "Расчёт стоимости через API")

' Трейсинг связи (КРАСНЫЙ)
Rel(shop_api, otel_collector, "Экспорт трейсов", $tags="tracing")
Rel(crm_api, otel_collector, "Экспорт трейсов", $tags="tracing")
Rel(mes_api, otel_collector, "Экспорт трейсов", $tags="tracing")
Rel(otel_collector, jaeger, "Отправка трейсов", $tags="tracing")

' Мониторинг связи (ЗЕЛЁНЫЙ)
Rel(otel_collector, prometheus, "Экспорт метрик", $tags="monitoring")
Rel(prometheus, alertmanager, "Триггерит алерты", $tags="monitoring")
Rel(alertmanager, grafana, "Уведомления", $tags="monitoring")
Rel(grafana, prometheus, "Запрос метрик", $tags="monitoring")

' Легенда для цветов
AddElementTag("tracing", $bgColor="#FF6B6B", $borderColor="#FF0000", $fontColor="#FFFFFF")
AddElementTag("monitoring", $bgColor="#51CF66", $borderColor="#008000", $fontColor="#FFFFFF")

@enduml